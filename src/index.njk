                    <h3 class="item-title">Cloudflare</h3>
                </div><!--//item-inner-->
            </div><!--//item-->

            <div class="item col-6 col-lg-3">
                <div class="item-inner">
                    <div class="item-icon"><i class="fas fa-cloud"></i></div>
                    <h3 class="item-title">GCP</h3>
                </div><!--//item-inner-->
            </div><!--//item-->

            <div class="item col-6 col-lg-3">
                <div class="item-inner">
                    <div class="item-icon"><i class="fab fa-aws"></i></div>
