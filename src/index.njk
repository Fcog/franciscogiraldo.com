            <div class="col-12">
                <h3 class="font-1.5 text-u">Languages</h3>
            </div>
        </div>

        <div class="row mb-4">

            <div class="item col-6 col-lg-3">
                <div class="item-inner">
                    <div class="item-icon"><i class="fab fa-js"></i></div>
                    <h3 class="item-title">JavaScript</h3>
                </div><!--//item-inner-->
            </div><!--//item-->

            <div class="item col-6 col-lg-3">
                <div class="item-inner">
                    <div class="item-icon"><i class="fas fa-code"></i></div>
                    <h3 class="item-title">TypeScript</h3>
                </div><!--//item-inner-->
            </div><!--//item-->

        </div>

        <div class="row mb-2">
            <div class="col-12">
                <h3 class="font-1.5 text-u">Services</h3>
            </div>
        </div>

        <div class="row mb-4">

            <div class="item col-6 col-lg-3">
                <div class="item-inner">
                    <div class="item-icon"><i class="fas fa-cubes"></i></div>
                    <h3 class="item-title">NestJS</h3>
                </div><!--//item-inner-->
            </div><!--//item-->

            <div class="item col-6 col-lg-3">
                <div class="item-inner">
                    <div class="item-icon"><i class="fas fa-exchange-alt"></i></div>
                    <h3 class="item-title">RabbitMQ</h3>
                </div><!--//item-inner-->
            </div><!--//item-->

            <div class="item col-6 col-lg-3">
                <div class="item-inner">
                    <div class="item-icon"><i class="fas fa-database"></i></div>
                    <h3 class="item-title">Redis</h3>
                </div><!--//item-inner-->
            </div><!--//item-->

        </div>

        <div class="row mb-2">
            <div class="col-12">
                <h3 class="font-1.5 text-u">Delivery</h3>
            </div>
        </div>

        <div class="row mb-4">

            <div class="item col-6 col-lg-3">
                <div class="item-inner">
                    <div class="item-icon"><i class="fab fa-docker"></i></div>
                    <h3 class="item-title">Docker</h3>
                </div><!--//item-inner-->
            </div><!--//item-->

            <div class="item col-6 col-lg-3">
                <div class="item-inner">
                    <div class="item-icon"><i class="fas fa-dharmachakra"></i></div>
                    <h3 class="item-title">Kubernetes</h3>
                </div><!--//item-inner-->
            </div><!--//item-->

            <div class="item col-6 col-lg-3">
                <div class="item-inner">
                    <div class="item-icon"><i class="fas fa-box"></i></div>
                    <h3 class="item-title">Helm</h3>
                </div><!--//item-inner-->
            </div><!--//item-->

            <div class="item col-6 col-lg-3">
                <div class="item-inner">
                    <div class="item-icon"><i class="fas fa-sync-alt"></i></div>
                    <h3 class="item-title">Argo CD</h3>
                </div><!--//item-inner-->
            </div><!--//item-->

            <div class="item col-6 col-lg-3">
                <div class="item-inner">
                    <div class="item-icon"><i class="fab fa-git-alt"></i></div>
                    <h3 class="item-title">Git</h3>
                </div><!--//item-inner-->
            </div><!--//item-->

            <div class="item col-6 col-lg-3">
                <div class="item-inner">
                    <div class="item-icon"><i class="fas fa-infinity"></i></div>
                    <h3 class="item-title">CI/CD</h3>
                </div><!--//item-inner-->
            </div><!--//item-->

        </div>

        <div class="row mb-2">
            <div class="col-12">
                <h3 class="font-1.5 text-u">Observability</h3>
            </div>
        </div>

        <div class="row mb-4">

            <div class="item col-6 col-lg-3">
                <div class="item-inner">
                    <div class="item-icon"><i class="fas fa-binoculars"></i></div>
                    <h3 class="item-title">Groundcover</h3>
                </div><!--//item-inner-->
            </div><!--//item-->

            <div class="item col-6 col-lg-3">
                <div class="item-inner">
                    <div class="item-icon"><i class="fas fa-chart-line"></i></div>
                    <h3 class="item-title">Grafana</h3>
                </div><!--//item-inner-->
