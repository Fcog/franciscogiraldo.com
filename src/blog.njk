---
title: Blog
layout: layout.njk
js: ["plugins/imagesloaded.pkgd.min.js", "plugins/isotope.pkgd.min.js", "js/isotope-custom.js"]
---

<section class="cta-section theme-bg-light py-5">
    <div class="container text-center">
        <h2 class="heading">Notes About Software Development</h2>
        <div class="intro">Archive of notes about concepts and tools from Software Development.</div>
    </div><!--//container-->
</section>

<section class="blog-list px-3 py-5 p-md-5">
    <div class="container">
        <div class="text-center">
            <ul id="filters" class="filters mb-5 mx-auto pl-0">
                <li class="type active mb-3 mb-lg-0" data-filter="*">All</li>
                {% for tag in collections.postTags %}
                <li class="type mb-3 mb-lg-0" data-filter=".{{ tag.slug }}">{{ tag.name }}</li>
                {% endfor %}
            </ul><!--//filters-->
        </div>

        <div class="row isotope">

            {% for post in collections.posts | reverse %}
                <div class="isotope-item col-md-4 mb-3 {{ post.data.post_tags | tagClasses }}">
                    <div class="card blog-post-card">
                        <div class="card-body">
                            <h5 class="card-title"><a class="theme-link" href="{{ post.url }}">{{ post.data.title }}</a></h5>
                            <p class="card-text">{{ post.data.excerpt }}</p>
                            <p class="mb-0"><a class="more-link" href="{{ post.url }}">Read more &rarr;</a></p>
                        </div>
                        <div class="card-footer">
                            <div class="card-text mb-2"> Tags:
                            {% for tag in post.data.post_tags %}
                                <small class="text-muted mr-1">{{ tag }}</small>
                            {% endfor %}  
                             </div>
                            <small class="text-muted">Published {{ post.date.toUTCString() }}</small>
                        </div>
                    </div><!--//card-->
                </div><!--//col-->
            {% endfor %}  

        </div><!--//row-->
        
    </div>
</section>