---
title: Resume
layout: layout.njk
---

<section class="cta-section theme-bg-light py-5">
    <div class="container text-center single-col-max-width">
        <h2 class="heading mb-3">Online Resume</h2>
        <p>Latest update: October 2026</p>
        <button class="btn btn-primary" onclick="javascript:window.print();">
            <i class="fas fa-file-pdf mr-2"></i>Download PDF Version
        </button>
    </div><!--//container-->
</section>

<div class="container px-3 px-lg-5">
    <article class="resume-wrapper mx-auto theme-bg-light p-5 mb-5 my-5 shadow-lg">

        <div class="resume-header">
            <div class="row align-items-center">
                <div class="resume-title col-12 col-md-6 col-lg-8 col-xl-9">
                    <h2 class="resume-name mb-0 text-uppercase">Francisco Giraldo</h2>
                    <div class="resume-tagline mb-3 mb-md-0 font-weight-bold">Senior Backend Engineer</div>
                </div><!--//resume-title-->
                <div class="resume-contact col-12 col-md-6 col-lg-4 col-xl-3">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><i class="fas fa-phone fa-fw fa-lg mr-2 "></i>
                            <a class="resume-link" href="tel:0629294063">0629294063</a>
                        </li>                        
                        <li class="mb-2"><i class="fas fa-envelope-square fa-fw fa-lg mr-2"></i>
                            <a class="resume-link" href="mailto:fcog111@gmail.com">fcog111@gmail.com</a>
                        </li>
                        <li class="mb-0"><i class="fas fa-map-marker-alt fa-fw fa-lg mr-2"></i>
                            <a 
                                class="resume-link"
                                target="_blank"
                                href="https://maps.app.goo.gl/fT6aV7ym2s6S7NRv7">
                                Almere, Netherlands
                            </a>
                        </li>
                    </ul>
                </div><!--//resume-contact-->
            </div><!--//row-->
            
        </div><!--//resume-header-->

        <hr>

        <div class="py-3 resume-intro">

            <div class="media flex-column flex-md-row align-items-center mb-3">
                <img class="resume-profile-image mb-3 mb-md-0 mr-md-5 ml-md-0 rounded mx-auto" src="/assets/images/Francisco Giraldo.jpg" alt="Profile image">
                <div class="media-body text-left">
                    <p class="mb-2">
Senior Backend Engineer with 5+ years building and running services for high-traffic products at Scribbr, LanguageTool and QuillBot. I’ve taken systems from first idea to production, most recently building QuillBot’s moderation and compliance services from scratch with the Legal and Compliance teams. I’m at my best building new services from the ground up and owning them all the way to production.
                    </p>

                    <ul class="resume-social-list list-inline mx-auto mb-0 d-inline-block">
                        <li class="list-inline-item mb-lg-0 mr-3">
                            <a class="resume-link" href="https://github.com/fcog" target="_blank">
                                <i class="fab fa-github-square fa-2x mr-2" data-fa-transform="down-4"></i>
                                <span class="d-none d-md-inline-block ">github.com/fcog</span>
                            </a>
                        </li>
                        <li class="list-inline-item mb-lg-0 mr-3">
                            <a class="resume-link" href="https://linkedin.com/in/franciscogiraldo" target="_blank">
                                <i class="fab fa-linkedin fa-2x mr-2" data-fa-transform="down-4"></i>
                                <span class="d-none d-md-inline-block">linkedin.com/in/franciscogiraldo</span>
                            </a>
                        </li>
                        <li class="list-inline-item mb-lg-0 mr-3">
                            <a class="resume-link" href="https://franciscogiraldo.com" target="_blank">
                                <i class="fas fa-globe fa-2x mr-2" data-fa-transform="down-4"></i>
                                <span class="d-none d-md-inline-block">franciscogiraldo.com</span>
                            </a>    
                        </li>
                    </ul>

                </div><!--//media-body-->

            </div>

        </div><!--//resume-intro-->

        <hr>

        <div class="resume-body">
            <div class="row">
            
                <div class="resume-main col-12 col-lg-8 col-xl-9 pr-0 pr-lg-5">
                    <section class="work-section pb-3">
                        <h3 class="text-uppercase resume-section-heading mb-4">Currently Interested In</h3>
                        <div class="item-content">
                            <p>Looking for a company where I can work on:</p>
                            <ul class="resume-list">
                                <li>Low-level design of distributed systems.</li>
                                <li>Cloud setup that keeps those systems scalable and highly available.</li>
                                <li>Internal services that communicate through REST APIs and messaging contracts.</li>
                                <li>Containerized TypeScript applications on Kubernetes and Helm.</li>
                                <li>CI/CD in GitLab.</li>
                            </ul>
                        </div>
                    </section>

                    <section class="work-section">
                        <h3 class="text-uppercase resume-section-heading mb-4">Work Experience (Last 5 years)</h3>

                        {% for work in resume.work_experience %}
                            {% if loop.index0 < 3 %}
                            <div class="item mb-4">
                                <div class="item-heading row align-items-center mb-2">
                                    <h4 class="item-title col-12 col-md-4 mb-2 mb-md-0">{{ work.role }}</h4>
                                    <div class="item-meta col-12 col-md-8 text-muted text-left text-md-right">
                                        <a target="_blank" href="{{ work.company_website }}">
                                            {{ work.company }}
                                        </a> | {{ work.date_start }} - {{ work.date_end }} | {{ work.location }}
                                    </div>
                                    
                                </div>
                                <div class="item-content">
                                    <p>{{ work.description }}</p>
                                    <ul class="resume-list">
                                        {% for task in work.tasks %}
                                            <li>{{ task }}</li>
                                        {% endfor %}
                                    </ul>
                                    <div class="d-inline-flex">
                                         <ul class="list-inline">
                                            {% for tech in work.technologies %}
                                                <li class="badge">{{ tech }}</li>
                                            {% endfor %}
                                        </ul>
                                    </div>
                                </div>
                            </div><!--//item-->
                            {% endif %}

                        {% endfor %}
                        
                    </section><!--//work-section-->

                    
                    <section class="project-section">

                        <div class="row">
                            <div class="col-sm-12">
                                <h3 class="text-uppercase resume-section-heading mb-4">Project Highlights</h3>
                            </div>
                        </div>

                        <div class="item mb-3">
                            <div class="item-heading row align-items-center mb-2">
                                <h4 class="item-title col-12 col-md-6 col-lg-8 mb-2 mb-md-0">
                                    User-Data Compliance Service (QuillBot)
                                </h4>
                                <div class="item-meta col-12 col-md-6 col-lg-4 text-muted text-left text-md-right">
                                    NestJS, PostgreSQL, RabbitMQ, GCP
                                </div>
                            </div>
                            <div class="item-content">
                        Designed and built an event-driven service that lets support and legal teams delete, disable, reinstate and export user data across all QuillBot products. It handles GDPR/CCPA requests and DMCA takedowns, tracks every job’s progress and logs who did what for audits.
                            </div>
                        </div><!--//item-->

                        <div class="item mb-3">
                            <div class="item-heading row align-items-center mb-2">
                                <h4 class="item-title col-12 col-md-6 col-lg-8 mb-2 mb-md-0">
                                    Content Moderation Service (QuillBot)
                                </h4>
                                <div class="item-meta col-12 col-md-6 col-lg-4 text-muted text-left text-md-right">
                                    NestJS, PostgreSQL, OpenAI Moderation API, GCP
                                </div>
                            </div>
                            <div class="item-content">
                            Designed and built a central service that screens user-written text, uploaded images and AI-generated images for harmful content across QuillBot products. It passes content to the OpenAI moderation API, maps the results to QuillBot’s own content categories and keeps a record of flagged content for review and policy tuning.
                            </div>
                        </div><!--//item-->

                    </section><!--//project-section-->	
                </div><!--//resume-main-->

                <aside class="resume-aside col-12 col-lg-4 col-xl-3 px-lg-4 pb-lg-4">

                    <section class="skills-section pb-3 pt-2">

                        <h3 class="text-uppercase resume-section-heading mb-3">Hard Skills</h3>
                        
                        {% for skill in resume.hard_skills %}

                            <div class="item">

                                {% if skill.title %}
                                    <h4 class="item-title">{{ skill.title }}</h4>
                                {% endif %}    

                                <ul class="list-unstyled resume-skills-list">
                                    {% for item in skill.items %}
                                        <li class="mb-1">{{ item }}</li>
                                    {% endfor %}
                                </ul>

                            </div><!--//item-->

                        {% endfor %}

                    </section><!--//skills-section-->    

                    <section class="skills-section py-2">    

                        <h3 class="text-uppercase resume-section-heading mb-3">Soft Skills</h3>

                        <div class="item">

                            <ul class="list-unstyled resume-skills-list">
                                {% for skill in resume.soft_skills %}
                                    <li class="mb-1">{{ skill }}</li>
                                {% endfor %}
                            </ul>
                            
                        </div><!--//item-->    

                    </section><!--//skills-section-->                  


                    <section class="education-section py-2">
                        <h3 class="text-uppercase resume-section-heading mb-3">Education</h3>
                        <ul class="list-unstyled resume-education-list">

                            {% for education in resume.education %}
                                <li class="mb-2">
                                    <div class="resume-degree font-weight-bold">
                                        <a href="https://franciscogiraldo.com/assets/docs/Diploma BS Computer Systems Engineer - Translated.pdf" target="_blank">
                                        {{ education.degree }}
                                        </a>
                                        </div>
                                    <div class="resume-degree-org text-muted">{{ education.location }}</div>
                                    <div class="resume-degree-time text-muted">{{ education.years }}</div>
                                </li>
                            {% endfor %}

                        </ul>
                    </section><!--//education-section-->

                    <section class="skills-section py-2">
                        <h3 class="text-uppercase resume-section-heading mb-3">Languages</h3>
                        <ul class="list-unstyled resume-lang-list">
                            <li class="mb-1">Spanish <span class="text-muted">(Native)</span></li>
                            <li class="mb-1">English <span class="text-muted">(Advanced)</span></li>
                            <li class="mb-1">French <span class="text-muted">(Intermediate)</span></li>
                            <li class="mb-1">Dutch <span class="text-muted">(Intermediate)</span></li>
                        </ul>
                    </section><!--//certificates-section-->


                    <section class="skills-section py-3">
                        <h3 class="text-uppercase resume-section-heading mb-3">Hobbies</h3>
                        <ul class="list-unstyled resume-interests-list mb-0">
                            <li class="mb-1">Playing electric guitar</li>
                            <li class="mb-1">Playing Chess</li>
                            <li class="mb-1">Playing video games</li>
                            <li class="mb-1">Bike riding</li>
                            <li>Inline skating</li>
                        </ul>
                    </section><!--//certificates-section-->
                            
                </aside><!--//resume-aside-->

            </div><!--//row-->
        </div><!--//resume-body-->

    </article>
    
</div><!--//container-->        
